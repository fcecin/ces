# Writes OUT, a C++ source that holds each markdown file under DOCS_DIR as a
# byte array, for src/cesh/man/embedded.h. Run as a script:
#   cmake -DDOCS_DIR=<dir> -DOUT=<file.cpp> -P embed_docs.cmake
# The file changes only when a page changes, so a build does not recompile it
# for nothing.

file(GLOB_RECURSE pages RELATIVE "${DOCS_DIR}" "${DOCS_DIR}/*.md")
list(SORT pages)

set(arrays "")
set(entries "")
set(count 0)
foreach(page IN LISTS pages)
  file(READ "${DOCS_DIR}/${page}" hex HEX)
  string(LENGTH "${hex}" hexlen)
  math(EXPR bytes "${hexlen} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(APPEND arrays "const unsigned char kPage${count}[] = {${hex}0x00};\n")
  string(APPEND entries
    "  {\"${page}\", reinterpret_cast<const char*>(kPage${count}), ${bytes}},\n")
  math(EXPR count "${count} + 1")
endforeach()
if(count EQUAL 0)
  set(entries "  {nullptr, nullptr, 0},\n")
endif()

set(text "// Generated by src/cesh/man/embed_docs.cmake from src/cesh/docs. Do not edit.
#include \"man/embedded.h\"

namespace ces::man {
namespace {
${arrays}}  // namespace

const EmbeddedPage kManualPages[] = {
${entries}};
const std::size_t kManualPageCount = ${count};

}  // namespace ces::man
")

file(WRITE "${OUT}.tmp" "${text}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
